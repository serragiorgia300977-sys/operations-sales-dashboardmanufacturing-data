from pyspark.sql.functions import col, sum

# Calcola quanti valori nulli ci sono per ogni colonna nella tabella Bronze
df_bronze = spark.sql("SELECT * FROM bronze_operations_sales")

df_bronze.select([
    sum(col(c).isNull().cast("int")).alias(c) for c in df_bronze.columns
]) # Modo corretto in Fabric se usi la funzione globale
display(df_bronze.limit(5))
